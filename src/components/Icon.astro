---
interface Props {
  name:
    | "arrow-left"
    | "badge-check"
    | "check-circle"
    | "clock"
    | "cpu"
    | "home"
    | "mail"
    | "map-pin"
    | "phone"
    | "wrench"
    | "zap";
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

<svg
  aria-hidden="true"
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="2"
  viewBox="0 0 24 24"
>
  {name === "phone" && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 3.08 6.18 2 2 0 0 1 5.06 4h3a2 2 0 0 1 2 1.72l.34 2.27a2 2 0 0 1-.57 1.73L8.1 11.45a16 16 0 0 0 4.45 4.45l1.73-1.73a2 2 0 0 1 1.73-.57l2.27.34A2 2 0 0 1 22 16.92Z" />
  )}
  {name === "mail" && (
    <>
      <rect height="14" rx="2" width="20" x="2" y="5" />
      <path d="m22 7-10 7L2 7" />
    </>
  )}
  {name === "map-pin" && (
    <>
      <path d="M12 21s-6-4.35-6-10a6 6 0 1 1 12 0c0 5.65-6 10-6 10Z" />
      <circle cx="12" cy="11" r="2.5" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 3" />
    </>
  )}
  {name === "check-circle" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m9 12 2 2 4-4" />
    </>
  )}
  {name === "zap" && <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" />}
  {name === "wrench" && (
    <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.4 2.4-2-2 2.4-2.4Z" />
  )}
  {name === "home" && (
    <>
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5 10.5V20h14v-9.5" />
    </>
  )}
  {name === "cpu" && (
    <>
      <rect height="10" rx="2" width="10" x="7" y="7" />
      <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
      <path d="M9.5 9.5h5v5h-5z" />
    </>
  )}
  {name === "arrow-left" && (
    <>
      <path d="M19 12H5" />
      <path d="m12 19-7-7 7-7" />
    </>
  )}
  {name === "badge-check" && (
    <>
      <path d="m12 3 2.1 2.1 3-.2.2 3L19.5 10 18 12l1.5 2-2.2 2.1-.2 3-3-.2L12 21l-2.1-2.1-3 .2-.2-3L4.5 14 6 12l-1.5-2 2.2-2.1.2-3 3 .2Z" />
      <path d="m9.5 12 1.7 1.7L14.8 10" />
    </>
  )}
</svg>
