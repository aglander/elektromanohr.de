---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { seoConfigs } from "@/lib/seo";
---

<BaseLayout includeStructuredData={false} seo={seoConfigs.notFound}>
  <div class="flex min-h-screen items-center justify-center bg-muted">
    <div class="text-center">
      <h1 class="mb-4 text-4xl font-bold">404</h1>
      <p class="mb-4 text-xl text-muted-foreground">
        Diese Seite wurde leider nicht gefunden.
      </p>
      <a class="text-primary underline hover:text-primary/90" href="/">
        Zur Startseite
      </a>
    </div>
  </div>
</BaseLayout>
