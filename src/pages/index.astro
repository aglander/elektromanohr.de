---
import { Image } from "astro:assets";
import Footer from "@/components/Footer.astro";
import Icon from "@/components/Icon.astro";
import heroImage from "@/assets/hero-elektromanohr.png";
import logo from "@/assets/logo-transparent.png";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { seoConfigs } from "@/lib/seo";

const services = [
  {
    icon: "zap",
    title: "Elektroinstallation & Neubau",
    text: "Wir planen und installieren komplette elektrische Anlagen - strukturiert, sicher und auf Ihre Anforderungen abgestimmt.",
  },
  {
    icon: "wrench",
    title: "Reparatur & schnelle Hilfe",
    text: "Wenn etwas nicht funktioniert, zählt vor allem eines: schnelle und zuverlässige Hilfe. Genau dafür stehen wir.",
  },
  {
    icon: "home",
    title: "Modernisierung & Sanierung",
    text: "Veraltete Elektroanlagen bringen wir auf den aktuellen Stand - für mehr Sicherheit, Effizienz und Zukunftssicherheit.",
  },
  {
    icon: "cpu",
    title: "Moderne Technik & Speziallösungen",
    text: "Von Wärmepumpen über Datennetzwerke bis hin zu Smart-Home-Systemen - wir verbinden klassische Elektroarbeit mit moderner Technik.",
  },
] as const;

const trustPoints = [
  "Über 35 Jahre Erfahrung im Elektrohandwerk",
  "Persönliche Betreuung statt wechselnder Ansprechpartner",
  "Saubere, zuverlässige und termingerechte Arbeit",
  "Regional verwurzelt in Grünheide und Umgebung",
];
---

<BaseLayout seo={seoConfigs.home}>
  <main>
    <section class="relative isolate overflow-hidden bg-background" id="hero">
      <div class="absolute inset-0 -z-20">
        <Image
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover"
          densities={[1, 1.5, 2]}
          fit="cover"
          formats={["avif", "webp"]}
          loading="eager"
          priority
          sizes="100vw"
          src={heroImage}
          width={1536}
        />
      </div>

      <div class="container-narrow section-padding relative text-center">
        <Image
          alt="Elektroinstallation Ing. Olaf Manohr"
          class="mx-auto mb-10 h-16 w-auto md:h-20"
          formats={["avif", "webp"]}
          loading="eager"
          priority
          sizes="(min-width: 768px) 320px, 256px"
          src={logo}
          widths={[256, 320, 480]}
        />
        <h1 class="mb-6 text-3xl font-semibold leading-tight md:text-5xl lg:text-[3.25rem] lg:leading-[1.15]">
          Elektriker in Grünheide -
          <span class="text-primary">seit über 35&nbsp;Jahren</span>
          zuverlässig für Sie im Einsatz
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg leading-relaxed text-muted-foreground md:text-xl">
          Ob Elektroinstallation im Neubau, Reparatur im Bestand oder
          Modernisierung Ihrer Anlage: Wir sorgen in Grünheide (Mark) und
          Umgebung dafür, dass Ihre Elektrik sicher und zuverlässig
          funktioniert.
        </p>
        <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-8 py-4 text-lg font-semibold text-primary-foreground transition-colors hover:bg-primary/90"
            href="tel:+4933626263"
          >
            <Icon class="h-5 w-5" name="phone" />
            Jetzt anrufen
          </a>
          <a
            class="inline-flex items-center gap-2 rounded-lg border-2 border-primary px-8 py-4 text-lg font-semibold text-primary transition-colors hover:bg-accent"
            href="#kontakt"
          >
            <Icon class="h-5 w-5" name="mail" />
            Anfrage senden
          </a>
        </div>
        <p class="mt-6 text-sm text-muted-foreground">
          Über 35 Jahre Erfahrung im Elektrohandwerk
        </p>
      </div>
    </section>

    <section class="section-padding bg-card" id="vertrauen">
      <div class="container-narrow">
        <h2 class="mb-8 text-center text-2xl font-semibold md:text-3xl">
          Elektroarbeiten sind Vertrauenssache
        </h2>
        <p class="mx-auto max-w-2xl text-center text-lg leading-relaxed text-muted-foreground">
          Seit mehr als 35&nbsp;Jahren steht Elektroinstallation
          Ing.&nbsp;Olaf Manohr für saubere Arbeit, klare Absprachen und
          zuverlässige Umsetzung. Unsere Kunden aus Grünheide (Mark) und der
          Umgebung schätzen vor allem, dass wir erreichbar sind, mitdenken und
          Lösungen finden, die im Alltag wirklich funktionieren.
        </p>
      </div>
    </section>

    <section class="section-padding bg-background" id="leistungen">
      <div class="container-wide">
        <h2 class="mb-4 text-center text-2xl font-semibold md:text-3xl">
          Unsere Leistungen
        </h2>
        <p class="mx-auto mb-14 max-w-2xl text-center text-lg text-muted-foreground">
          Wir decken das gesamte Spektrum moderner Elektroinstallation in
          Grünheide (Mark) und Umgebung ab - von kleinen Reparaturen bis zu
          umfangreichen Projekten.
        </p>
        <div class="grid gap-8 sm:grid-cols-2">
          {services.map((service) => (
            <article class="rounded-xl border border-border bg-card p-8 transition-shadow hover:shadow-md">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-lg bg-accent">
                <Icon class="h-6 w-6 text-accent-foreground" name={service.icon} />
              </div>
              <h3 class="mb-2 text-xl font-semibold">{service.title}</h3>
              <p class="leading-relaxed text-muted-foreground">{service.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-padding bg-card" id="warum-wir">
      <div class="container-narrow">
        <h2 class="mb-4 text-center text-2xl font-semibold md:text-3xl">
          Warum Kunden uns wählen
        </h2>
        <p class="mb-10 text-center text-lg text-muted-foreground">
          Warum sich Kunden seit Jahrzehnten für uns entscheiden:
        </p>
        <ul class="mx-auto max-w-lg space-y-5">
          {trustPoints.map((point) => (
            <li class="flex items-start gap-3">
              <Icon class="mt-0.5 h-6 w-6 flex-shrink-0 text-primary" name="check-circle" />
              <span class="text-lg">{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section-padding bg-background" id="kontakt">
      <div class="container-narrow">
        <h2 class="mb-4 text-center text-2xl font-semibold md:text-3xl">
          Jetzt Kontakt aufnehmen
        </h2>
        <p class="mx-auto mb-14 max-w-2xl text-center text-lg text-muted-foreground">
          Sie suchen einen Elektriker in Grünheide (Mark), auf den Sie sich
          verlassen können? Dann melden Sie sich bei uns - wir kümmern uns
          darum.
        </p>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)] lg:items-stretch">
          <div class="order-2 flex h-full flex-col rounded-2xl border border-border bg-card p-6 shadow-sm md:p-8 lg:order-1">
            <h3 class="mb-2 text-xl font-semibold md:text-2xl">
              Anfrage senden
            </h3>
            <p class="mb-8 text-muted-foreground">
              Schreiben Sie uns kurz, worum es geht. Wir melden uns
              schnellstmöglich bei Ihnen zurück.
            </p>

            <form class="space-y-6" data-contact-form>
              <div class="space-y-2">
                <label class="text-sm font-medium leading-none" for="contact-name">
                  Name
                </label>
                <input
                  autocomplete="name"
                  class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
                  id="contact-name"
                  name="Name"
                  required
                  type="text"
                />
              </div>

              <div class="grid gap-6 md:grid-cols-2">
                <div class="space-y-2">
                  <label class="text-sm font-medium leading-none" for="contact-email">
                    Email
                  </label>
                  <input
                    autocomplete="email"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
                    id="contact-email"
                    name="Email"
                    required
                    type="email"
                  />
                </div>

                <div class="space-y-2">
                  <label class="text-sm font-medium leading-none" for="contact-phone">
                    Telefonnummer
                  </label>
                  <input
                    autocomplete="tel"
                    class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
                    id="contact-phone"
                    name="Telefonnummer"
                    type="tel"
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label class="text-sm font-medium leading-none" for="contact-message">
                  Nachricht
                </label>
                <textarea
                  class="flex min-h-[120px] w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm"
                  id="contact-message"
                  name="Nachricht"
                  required
                  rows="6"
                ></textarea>
              </div>

              <p
                aria-live="polite"
                class="hidden rounded-md border border-destructive/20 bg-destructive/5 px-4 py-3 text-sm text-destructive"
                data-form-error
                role="status"
              ></p>

              <button
                class="inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground ring-offset-background transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
                data-submit-button
                type="submit"
              >
                Nachricht senden
              </button>
            </form>
          </div>

          <div class="order-1 flex h-full flex-col rounded-2xl border border-border bg-background p-6 md:p-8 lg:order-2">
            <div class="mb-8">
              <h3 class="mb-2 text-xl font-semibold md:text-2xl">
                Direkt erreichbar
              </h3>
              <p class="text-muted-foreground">
                Wenn es schneller gehen soll, erreichen Sie uns auch telefonisch
                oder per E-Mail.
              </p>
            </div>

            <div class="space-y-8">
              <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                <Icon class="mt-0.5 h-6 w-6 text-primary" name="map-pin" />
                <p class="font-semibold">Adresse</p>
                <div></div>
                <p class="text-muted-foreground">
                  Gottesbrück 8, 15537 Grünheide (Mark)
                </p>
              </div>
              <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                <Icon class="mt-0.5 h-6 w-6 text-primary" name="phone" />
                <p class="font-semibold">Telefon</p>
                <div></div>
                <a class="text-primary underline-offset-2 hover:underline" href="tel:+4933626263">
                  +49 3362 6263
                </a>
              </div>
              <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                <Icon class="mt-0.5 h-6 w-6 text-primary" name="mail" />
                <p class="font-semibold">E-Mail</p>
                <div></div>
                <a class="text-primary underline-offset-2 hover:underline" href="mailto:info@elektromanohr.de">
                  info@elektromanohr.de
                </a>
              </div>
              <div class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
                <Icon class="mt-0.5 h-6 w-6 text-primary" name="clock" />
                <p class="font-semibold">Öffnungszeiten</p>
                <div></div>
                <div class="space-y-1 text-muted-foreground">
                  <p>Mo-Do: 7:30 - 16:00 Uhr</p>
                  <p>Fr: 7:30 - 13:00 Uhr</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <Footer />
  </main>

  <script>
    const form = document.querySelector("[data-contact-form]");

    if (form instanceof HTMLFormElement) {
      const errorMessage = form.querySelector("[data-form-error]");
      const submitButton = form.querySelector("[data-submit-button]");
      const defaultButtonText = submitButton?.textContent ?? "Nachricht senden";

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!(submitButton instanceof HTMLButtonElement)) {
          return;
        }

        if (errorMessage instanceof HTMLElement) {
          errorMessage.textContent = "";
          errorMessage.classList.add("hidden");
        }

        submitButton.disabled = true;
        submitButton.textContent = "Nachricht wird gesendet...";

        try {
          const formData = new FormData(form);
          const response = await fetch("https://form.taxi/s/wocfeuea", {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json",
            },
          });

          if (!response.ok) {
            throw new Error("Formular konnte nicht gesendet werden");
          }

          window.location.href = "/danke";
        } catch {
          if (errorMessage instanceof HTMLElement) {
            errorMessage.textContent =
              "Ihre Nachricht konnte gerade nicht gesendet werden. Bitte versuchen Sie es erneut oder melden Sie sich telefonisch.";
            errorMessage.classList.remove("hidden");
          }
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = defaultButtonText;
        }
      });
    }
  </script>
</BaseLayout>
